[Version]
Signature="$WINDOWS NT$"
Class=AudioProcessingObject
ClassGuid={5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider=%Creative%
DriverVer=09/26/2024,3.06.03.00
CatalogFile=ctusbacom.cat
PnpLockdown=1

[SourceDisksNames]
222 = %DiskId1%

[SourceDisksFiles]
CTUSBAPO64.dll=222,AMD64
CTUSBAPO32.dll=222,I386

[DestinationDirs]
CTAPO.x64.CopyList=11
CTAPO.x86.CopyList=11
CTAPO.x86.CopyList_SysWow64=10,SysWOW64

[SignatureAttributes]
CTUSBAPO64.dll=SignatureAttributes.PETrust
CTUSBAPO32.dll=SignatureAttributes.PETrust

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%Creative% = Components,NTamd64.10.0...22000,NTx86.10.0...22000,NTx86.10.0...17763, NTamd64.10.0...17763

[Components.NTamd64.10.0...22000]
%ComponentDesc% = Component_Install.NTamd64,SWC\VID_041E&AID_0001

[Components.NTx86.10.0...22000]
%ComponentDesc% = Component_Install.NTx86,SWC\VID_041E&AID_0001

[Components.NTamd64.10.0...17763]
%ComponentDesc% = Component_Install.NTamd64,SWC\VID_041E&AID_0001

[Components.NTx86.10.0...17763]
%ComponentDesc% = Component_Install.NTx86,SWC\VID_041E&AID_0001


[Component_Install.NTamd64]
CopyFiles = CTAPO.x64.CopyList, CTAPO.x86.CopyList_SysWow64
AddReg = CTAPO.x64.AddReg,CTAPO.AddReg,CTAPO.Misc1.AddReg,CTAPO.Misc2.AddReg

[Component_Install.NTx86]
