AddReg = CTAPO.x86.AddReg,CTAPO.AddReg,CTAPO.Misc1.AddReg,CTAPO.Misc2.AddReg

[Component_Install.NTamd64.Services]
AddService = , 2

[Component_Install.NTx86.Services]
